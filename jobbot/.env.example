# Required: Get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required for Adzuna job search: Get free key at developer.adzuna.com
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# Required for sending emails: Use a Gmail App Password
# Enable 2FA on Gmail → Google Account → Security → App Passwords → Create
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: Your name for cover letter signatures
YOUR_NAME=Your Full Name

# Optional: target country for Adzuna (us, gb, au, ca, de, fr, etc.)
ADZUNA_COUNTRY=us

# Optional: minimum fit score (1-10) to auto-draft a cover letter
MIN_SCORE_TO_DRAFT=6.5

# Optional: how many jobs to pull per search run
JOBS_PER_SEARCH=50
